# Local artefacts only: the SQLite database under data/db, its -wal/-shm
# siblings and application logs. The whole directory is excluded rather than the
# .db file alone -- the WAL holds committed pages that haven't been checkpointed
# back yet, so it carries transcript content too. The corpus is not here: it is
# tracked in Documents/ (plan §3.2, decision D8 as reversed).
data/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
.vite/
coverage/

# Env files — never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local databases
*.sqlite
*.sqlite3
*.db
