# Local data, none of it tracked: the SQLite database and its -wal/-shm
# siblings under data/db, application logs under data/logs, and client source
# material under data/source (plan §3.2, decision D8). The whole directory is
# excluded rather than the .db file alone -- the WAL holds committed pages that
# haven't been checkpointed back yet, so it carries transcript content too.
data/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
.vite/
coverage/

# Env files — never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local databases
*.sqlite
*.sqlite3
*.db
