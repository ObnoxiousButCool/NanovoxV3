# Local artefacts only: the SQLite database under data/db, its -wal/-shm
# siblings and application logs. The whole directory is excluded rather than the
# .db file alone -- the WAL holds committed pages that haven't been checkpointed
# back yet, so it carries transcript content too. The corpus is not here: it is
# tracked in Documents/ (plan §3.2, decision D8 as reversed).
data/

# Python
__pycache__/
*.pyc
.venv/
.venv-linux/
venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
.vite/
coverage/

# Env files — never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local databases
*.sqlite
*.sqlite3
*.db

# Local editor and agent scaffolding, not project configuration.
.claude/

# Shipped release artefacts: a 77 MB image tarball and a copy of the
# corpus database. Built by `docker save`, never committed.
release/*.tar
release/*.tar.gz
release/*.db
