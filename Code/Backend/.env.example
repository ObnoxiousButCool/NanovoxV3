# Copy to .env and adjust. Every value here has a working default in
# infrastructure/config/settings.py; this file documents what's tunable.

# --- Application -------------------------------------------------------
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Database (decision D9) ---------------------------------------------
# SQLite locally by default (see infrastructure/config/paths.py). Point at
# Postgres in a deployment:
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
DB_ECHO=false

# --- Model providers (decision D1) ---------------------------------------
# openai is the default; anthropic and ollama are the two configurable
# extras (no Azure Foundry adapter). Cloud keys are blank by default —
# GET /api/v1/providers reports each provider as configured/reachable or not.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Login (feature/email-otp-login, not on main) -------------------------
# One shared username and password for the whole application (leadership,
# 2026-10-08), not a per-person account. AUTH_PASSWORD_HASH is produced by
# domain/value_objects/password_hash.py's hash_password — never put the
# plaintext password here. Generate one with:
#   python -c "from domain.value_objects.password_hash import hash_password; print(hash_password('the password'))"
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
# Required outside local development — an empty secret makes every session
# forgeable. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRY_MINUTES=720

# --- Logging -------------------------------------------------------------
LOG_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=14
LOG_TO_CONSOLE=true
# Off by default: transcripts are member conversations.
LOG_LLM_PROMPTS=false
